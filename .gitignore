# Dados financeiros locais: nunca versionar.
data/**
!data/**/
!data/**/.gitkeep

# Artefatos locais que serão recriados durante o novo desenvolvimento.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Relatórios pessoais gerados localmente.
output/**
!output/.gitkeep
tmp/**

# Notebooks versionados não carregam saídas pessoais.
.ipynb_checkpoints/
